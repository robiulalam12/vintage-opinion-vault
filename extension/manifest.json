{
  "manifest_version": 3,
  "name": "People Opinion Box \u2014 DMCA Autofill",
  "version": "1.12.0",
  "description": "Reports Google review copies for you (batch or one-by-one) and collects reviewer profile URLs for profile reports.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "https://support.google.com/*",
    "https://reportcontent.google.com/*",
    "https://peopleopinionbox.com/*",
    "https://www.peopleopinionbox.com/*",
    "https://*.lovable.app/*",
    "https://2captcha.com/*",
    "https://www.google.com/maps/*",
    "https://www.google.com/*",
    "https://maps.app.goo.gl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://support.google.com/legal/*",
        "https://reportcontent.google.com/forms/*"
      ],
      "js": [
        "config.js",
        "content.js",
        "runner.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.com/local/*"
      ],
      "js": [
        "config.js",
        "capture.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
