{
  "manifest_version": 3,
  "name": "Policy Violation",
  "version": "1.3.0",
  "description": "Submits prepared Google Maps policy violation reports one at a time without skipping items.",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "debugger"],
  "host_permissions": [
    "https://reportcontent.google.com/*",
    "https://peopleopinionbox.com/*",
    "https://www.peopleopinionbox.com/*",
    "https://*.lovable.app/*",
    "https://2captcha.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": { "48": "icon.png", "128": "icon.png" } },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://reportcontent.google.com/forms/*"],
    "js": ["config.js", "content.js", "runner.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
